---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

{/* A labelled row: the label on the left, the content on the right on wider screens. */}
<div class:list={['row', className]}>
  <slot name="label" />
  <slot />
</div>

<style lang="scss">
  @use 'variables/breakpoints' as *;

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2) var(--row-column-gap);
    padding-block: var(--space-6);
    border-top: var(--border-width) solid var(--color-line);

    &:last-child {
      border-bottom: var(--border-width) solid var(--color-line);
    }

    @include md {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }
</style>
