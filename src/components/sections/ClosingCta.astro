---
import { BRAND, PRODUCT_NAME } from '../../consts/product';
import { LINKS } from '../../consts/site';
import Button from '../Button.astro';
import PageHero from '../PageHero.astro';
---

<PageHero id="talk-to-us" variant="closing" heading="Stop making your users wait for your agent.">
  <Fragment slot="lead">
    Tell us about your agents, your stack and the work you want them to take on.
  </Fragment>
  <Button href={LINKS.contact} target="_blank" rel="noopener" size="lg">Talk to us</Button>
</PageHero>
