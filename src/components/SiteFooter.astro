---
import { BRAND } from '../consts/product';
import { LINKS } from '../consts/site';
import Container from './Container.astro';
import Logo from './Logo.astro';
import NavLink from './NavLink.astro';
---

<footer class="footer" data-theme="ink">
  <Container class="bar">
    <Logo size="sm" class="footer-logo" />
    <NavLink href={LINKS.neuronGithub} target="_blank" rel="noopener">{BRAND} on GitHub</NavLink>
    <NavLink href={LINKS.neuronDocs} target="_blank" rel="noopener">Documentation</NavLink>
  </Container>
</footer>

<style lang="scss">
  .footer {
    border-top: var(--border-width) solid var(--color-line);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-6);
    min-height: var(--size-footer);
    padding-block: var(--space-3);
  }

  .footer-logo {
    margin-inline-end: auto;
  }
</style>
