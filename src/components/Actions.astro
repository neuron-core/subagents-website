---
interface Props {
  /** Centers the actions in the row instead of starting them at its edge. */
  centered?: boolean;
  class?: string;
}

const { centered = false, class: className } = Astro.props;
---

<div class:list={['actions', { centered }, className]}><slot /></div>

<style lang="scss">
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .centered {
    justify-content: center;
  }
</style>
