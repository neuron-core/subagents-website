---
// The header and footer both use the dark theme, so the logo uses the mark drawn for dark backgrounds.
import mark from '../assets/neuron-iq-logo-dark.svg';
import { PRODUCT } from '../consts/product';
import { SITE_BRAND } from '../consts/site';

interface Props {
  size?: 'sm' | 'md';
  class?: string;
}

const { size = 'md', class: className } = Astro.props;
---

<span class:list={['logo', size, className]}>
  <img class="mark" src={mark.src} alt="" />
  <span class="words">
    <span class="brand">{SITE_BRAND}</span>
    <span class="product">{PRODUCT}</span>
  </span>
</span>

<style lang="scss">
  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .mark {
    display: block;
    flex: none;
    width: var(--size-mark);
    height: var(--size-mark);
  }

  .words {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .brand {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-title);
  }

  .product {
    font-size: var(--font-size-md);
    color: var(--color-text-muted);
  }

  .logo.sm {
    gap: var(--space-2-5);

    .mark {
      width: var(--size-mark-sm);
      height: var(--size-mark-sm);
    }

    .brand {
      font-size: var(--font-size-md);
      letter-spacing: normal;
    }

    .product {
      font-size: var(--font-size-sm);
    }
  }
</style>
