---
import { BRAND, PRODUCT } from '../consts/product';

interface Props {
  size?: 'sm' | 'md';
  class?: string;
}

const { size = 'md', class: className } = Astro.props;
---

<span class:list={['logo', size, className]}>
  {/* Two squares on a 10-unit grid, touching at a corner: the agent, and a sub-agent stepping off it to run on its own. */}
  <svg class="mark" viewBox="0 0 20 20" aria-hidden="true">
    <rect class="agent" x="0" y="10" width="10" height="10"></rect>
    <rect class="subagent" x="10" y="0" width="10" height="10"></rect>
  </svg>
  <span class="words">
    <span class="brand">{BRAND}</span>
    <span class="product">{PRODUCT}</span>
  </span>
</span>

<style lang="scss">
  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .mark {
    display: block;
    flex: none;
    width: auto;
    height: var(--size-mark);
  }

  .agent {
    fill: var(--color-logo);
  }

  .subagent {
    fill: var(--color-orange);
  }

  .words {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .brand {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-title);
  }

  .product {
    font-size: var(--font-size-md);
    color: var(--color-text-muted);
  }

  .logo.sm {
    gap: var(--space-2-5);

    .mark {
      height: var(--size-mark-sm);
    }

    .brand {
      font-size: var(--font-size-md);
      letter-spacing: normal;
    }

    .product {
      font-size: var(--font-size-sm);
    }
  }
</style>
