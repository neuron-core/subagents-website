---
import { PRODUCT } from '../consts/product';
import { SITE_BRAND } from '../consts/site';

interface Props {
  size?: 'sm' | 'md';
  class?: string;
}

const { size = 'md', class: className } = Astro.props;

// The Neuron IQ pixel mark, as in src/assets/neuron-iq-logo*.svg: a 6 × 6 grid of squares crossed by a diagonal,
// with a shadow below it and an accent square in the top right corner. It's drawn here so its colors come from
// the theme it sits on.
const SIDE = 6;
const SQUARE = 45;
const STEP = 51;
const squares = Array.from({ length: SIDE * SIDE }, (_, i) => {
  const column = i % SIDE;
  const row = Math.floor(i / SIDE);
  const diagonal = column + row;
  const kind = diagonal === SIDE - 1 ? (row === 0 ? 'accent' : 'ink') : diagonal === SIDE ? 'shadow' : 'grid';
  return { x: column * STEP, y: row * STEP, kind };
});
---

<span class:list={['logo', size, className]}>
  <svg class="mark" viewBox={`0 0 ${STEP * (SIDE - 1) + SQUARE} ${STEP * (SIDE - 1) + SQUARE}`} shape-rendering="crispEdges" aria-hidden="true">
    {squares.map((square) => <rect class={square.kind} x={square.x} y={square.y} width={SQUARE} height={SQUARE} />)}
  </svg>
  <span class="words">
    <span class="brand">{SITE_BRAND}</span>
    <span class="product">{PRODUCT}</span>
  </span>
</span>

<style lang="scss">
  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .mark {
    display: block;
    flex: none;
    width: var(--size-mark);
    height: var(--size-mark);
  }

  .grid {
    fill: var(--color-surface);
  }

  .shadow {
    fill: var(--color-line);
  }

  .ink {
    fill: var(--color-text);
  }

  .accent {
    fill: var(--color-brand);
  }

  .words {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .brand {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-title);
  }

  .product {
    font-size: var(--font-size-md);
    color: var(--color-text-muted);
  }

  .logo.sm {
    gap: var(--space-2-5);

    .mark {
      width: var(--size-mark-sm);
      height: var(--size-mark-sm);
    }

    .brand {
      font-size: var(--font-size-md);
      letter-spacing: normal;
    }

    .product {
      font-size: var(--font-size-sm);
    }
  }
</style>
