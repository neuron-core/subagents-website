---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

{/* Takes `<thead>` and `<tbody>`; scrolls sideways on narrow screens. */}
<div class:list={['table-wrap', className]}>
  <table class="table"><slot /></table>
</div>

<style lang="scss">
  .table-wrap {
    min-width: 0;
    overflow-x: auto;
  }

  .table {
    width: 100%;
    min-width: var(--table-min);
    border-collapse: collapse;

    :global(th),
    :global(td) {
      text-align: left;
      vertical-align: top;
      padding: var(--space-3-5) var(--space-4) var(--space-3-5) 0;
      border-top: var(--border-width) solid var(--color-line);
      font-size: var(--font-size-sm);
      line-height: var(--leading-normal);
    }

    :global(thead th) {
      border-top: 0;
      padding-top: 0;
      padding-bottom: var(--space-2-5);
      font-size: var(--font-size-2xs);
      font-weight: var(--font-weight-regular);
      line-height: var(--leading-compact);
      color: var(--color-text-muted);
    }

    :global(tbody th) {
      font-weight: var(--font-weight-semibold);
    }

    :global(.ic) {
      font-size: var(--font-size-xs);
    }
  }
</style>
