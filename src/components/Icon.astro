---
const PATHS = {
  replay: [
    'M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2z',
    'M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466',
  ],
  check: [
    'M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z',
  ],
  bell: [
    'M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2M8 1.918l-.797.161A4 4 0 0 0 4 6c0 .628-.134 2.197-.459 3.742-.16.767-.376 1.566-.663 2.258h10.244c-.287-.692-.502-1.49-.663-2.258C12.134 8.197 12 6.628 12 6a4 4 0 0 0-3.203-3.92zM14.22 12c.223.447.481.801.78 1H1c.299-.199.557-.553.78-1C2.68 10.2 3 6.88 3 6c0-2.42 1.72-4.44 4.005-4.901a1 1 0 1 1 1.99 0A5 5 0 0 1 13 6c0 .88.32 4.2 1.22 6',
  ],
  'chevron-down': [
    'M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708',
  ],
};

interface Props {
  name: keyof typeof PATHS;
  size?: 'sm' | 'md';
  class?: string;
}

const { name, size = 'md', class: className } = Astro.props;
---

<svg class:list={['icon', size, className]} viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
  {PATHS[name].map((d) => <path d={d} />)}
</svg>

<style lang="scss">
  .icon {
    flex: none;
  }

  .icon.md {
    width: var(--size-icon);
    height: var(--size-icon);
  }

  .icon.sm {
    width: var(--size-icon-sm);
    height: var(--size-icon-sm);
  }
</style>
