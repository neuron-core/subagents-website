---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['container', className]}><slot /></div>

<style lang="scss">
  .container {
    box-sizing: content-box;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-gutter);
  }
</style>
