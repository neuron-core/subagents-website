---
import Actions from './Actions.astro';
import Container from './Container.astro';
import Split from './Split.astro';

interface Props {
  id: string;
  heading: string;
  /** `opening` tops the page with an h1 and an aside; `closing` is the dark call to action at the end. */
  variant?: 'opening' | 'closing';
}

const { id, heading, variant = 'opening' } = Astro.props;
const closing = variant === 'closing';
---

<section id={id} class:list={['page-hero', variant]} data-theme={closing ? 'ink' : undefined}>
  <Container>
    {
      closing ? (
        <div class="intro">
          <h2 class="t-display heading">{heading}</h2>
          <p class="t-lead measure muted">
            <slot name="lead" />
          </p>
          <Actions>
            <slot />
          </Actions>
          <p class="t-caption muted">
            <slot name="note" />
          </p>
        </div>
      ) : (
        <Split centered>
          <div class="intro">
            <h1 class="t-display title">{heading}</h1>
            <p class="t-lead measure muted">
              <slot name="lead" />
            </p>
            <Actions>
              <slot />
            </Actions>
            <p class="t-small muted">
              <slot name="note" />
            </p>
          </div>
          <slot name="aside" slot="aside" />
        </Split>
      )
    }
  </Container>
</section>

<style lang="scss">
  @use 'variables/breakpoints' as *;

  .page-hero {
    padding-block: var(--section-padding);
  }

  // The opening title is short, so it runs larger than the display scale. The sizes follow the
  // viewport so the title keeps the same number of lines as the column narrows.
  .title {
    font-size: clamp(var(--font-size-5xl), 11vw, 3rem);

    @include lg {
      font-size: clamp(4rem, 5.6vw, 4.5rem);
    }
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .heading {
    max-width: var(--measure-display);
  }
</style>
