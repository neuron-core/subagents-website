---
interface Props {
  /** On wide screens, the aside starts lower than the main column. */
  offset?: boolean;
  class?: string;
}

const { offset = false, class: className } = Astro.props;
---

<div class:list={['split', { offset }, className]}>
  <div class="main"><slot /></div>
  <div class="aside"><slot name="aside" /></div>
</div>

<style lang="scss">
  @use 'variables/breakpoints' as *;

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--split-gap);
    align-items: start;

    @include lg {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
  }

  .main,
  .aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
  }

  .offset > .aside {
    margin-top: var(--split-offset);
  }
</style>
